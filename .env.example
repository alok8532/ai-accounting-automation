# Copy to .env (git-ignored) and fill in. Never commit .env.

# Google Cloud -> Google Auth Platform -> Clients -> your "Desktop app" client
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# Gmail permission: "insert" (cannot send at all) or "compose" (drafts; sending blocked in our code)
GMAIL_SCOPE=insert

# Optional: where the Gmail login token is stored (default: %APPDATA%\ai-accounting-automation\gmail-token.json)
# GMAIL_TOKEN_FILE=

# Retainer invoices: allow creating Sales vouchers in Tally (only the company in config/retainer-billing.json).
# Take a Tally backup first. Keep false when not billing.
INVOICE_WRITE_ENABLED=false
